---
import '../styles/global.css'
import GlowCursor from '../components/GlowCursor.tsx'
import { ClientRouter } from 'astro:transitions'

interface Props {
  title?: string
  description?: string
}

const {
  title = '¡Feliz Cumpleaños Fresikari!',
  description = 'Que este nuevo año esté lleno de color, risas y momentos mágicos.',
} = Astro.props

const isSilentPage = ['/caso', '/caso/', '/foca', '/foca/'].includes(Astro.url.pathname)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    {!isSilentPage && (
      <>
        <audio
          id="birthday-music"
          src="/resources/more/Happy-Birthday.mp3"
          loop
          autoplay
          aria-hidden="true"
          transition:persist
        ></audio>
        <script>
          const birthdayMusic = document.querySelector('#birthday-music')
          if (birthdayMusic instanceof HTMLAudioElement) {
            birthdayMusic.volume = 0.4
            const playBirthdayMusic = () => {
              void birthdayMusic.play().catch(() => undefined)
            }

            playBirthdayMusic()
            window.addEventListener('pointerdown', playBirthdayMusic, { once: true })
            window.addEventListener('keydown', playBirthdayMusic, { once: true })
          }
        </script>
      </>
    )}
    <GlowCursor
      client:load
      color="#CF8ABB"
      secondaryColor="#2B6282"
      trailLength={40}
      trailWidth={8}
      trailTaper={0.8}
      followSpeed={0.46}
      glowIntensity={1.15}
      glowSpread={1.2}
      hotspot={0.18}
      brightness={0.9}
      opacity={0.92}
      pulseSpeed={1.1}
      noiseStrength={0.035}
      idleFade
      idleTimeout={700}
      fadeDuration={900}
      blendMode="normal"
    >
      <slot />
    </GlowCursor>
  </body>
</html>
