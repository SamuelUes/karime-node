---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = '¡Feliz Cumpleaños!',
  description = 'Que este nuevo año esté lleno de color, risas y momentos mágicos.',
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
