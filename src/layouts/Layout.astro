---
import '../styles/global.css'
import GlowCursor from '../components/GlowCursor.tsx'

interface Props {
  title?: string
  description?: string
}

const {
  title = '¡Feliz Cumpleaños!',
  description = 'Que este nuevo año esté lleno de color, risas y momentos mágicos.',
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <GlowCursor
      client:load
      color="#dddddd"
      secondaryColor="#ffffff"
      trailLength={40}
      trailWidth={8}
      trailTaper={0.8}
      followSpeed={0.46}
      glowIntensity={1.9}
      glowSpread={1.2}
      hotspot={0.65}
      brightness={5.25}
      opacity={1}
      pulseSpeed={1.1}
      noiseStrength={0.035}
      idleFade
      idleTimeout={700}
      fadeDuration={900}
      blendMode="screen"
    >
      <slot />
    </GlowCursor>
  </body>
</html>
