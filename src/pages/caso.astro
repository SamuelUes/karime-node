---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="The Stolen Cake · Fresikari"
  description="Un minijuicio especial para descubrir quién robó el pastel."
>
  <main class="case-page">
    <header class="case-header">
      <a class="case-back" href="/deseo" aria-label="Volver a los deseos">
        <span aria-hidden="true">←</span>
        Volver a mis deseos
      </a>
      <div class="case-heading">
        <span class="case-kicker">Taisita presents</span>
        <h1>The Stolen Cake</h1>
      </div>
      <span class="case-badge">Ace Attorney</span>
    </header>

    <section class="case-stage" aria-label="Minijuego The Stolen Cake">
      <div class="case-frame">
        <iframe
          src="/resources/more/AA-Case/play.html"
          title="The Stolen Cake, un minijuego de Ace Attorney"
          allow="autoplay; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  </main>
</Layout>

<style>
  .case-page {
    min-height: 100dvh;
    padding: 18px clamp(14px, 3vw, 36px) 28px;
    color: var(--color-ink);
    background:
      radial-gradient(circle at 8% 12%, rgba(255, 255, 255, 0.75), transparent 22rem),
      linear-gradient(145deg, var(--color-pink-soft), var(--color-blue-soft) 52%, var(--color-purple-soft));
  }

  .case-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 18px;
    width: min(1500px, 100%);
    margin: 0 auto 18px;
  }

  .case-back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .case-back span {
    font-size: 1.4rem;
    line-height: 1;
  }

  .case-heading {
    text-align: center;
  }

  .case-kicker {
    display: block;
    color: var(--color-ink-soft);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .case-heading h1 {
    margin: 2px 0 0;
    font-family: var(--font-body);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 700;
  }

  .case-badge {
    justify-self: end;
    padding: 8px 13px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-stage {
    width: min(1500px, 100%);
    margin: 0 auto;
  }

  .case-frame {
    position: relative;
    overflow: hidden;
    height: min(78dvh, 900px);
    min-height: 520px;
    border: 2px solid rgba(255, 255, 255, 0.72);
    border-radius: 18px;
    background: #111;
    box-shadow: 0 24px 70px rgba(91, 74, 106, 0.28);
  }

  .case-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #111;
  }

  @media (max-width: 700px) {
    .case-page {
      padding: 12px 10px 18px;
    }

    .case-header {
      grid-template-columns: 1fr auto;
      gap: 10px;
      margin-bottom: 12px;
    }

    .case-heading {
      grid-column: 1 / -1;
      grid-row: 1;
      margin-bottom: 4px;
    }

    .case-back {
      grid-column: 1;
      grid-row: 2;
      font-size: 0.86rem;
    }

    .case-badge {
      grid-column: 2;
      grid-row: 2;
      font-size: 0.64rem;
    }

    .case-frame {
      height: calc(100dvh - 128px);
      min-height: 440px;
      border-radius: 12px;
    }
  }
</style>
