---
import Layout from '../layouts/Layout.astro'
import SealVisualNovel from '../components/SealVisualNovel.tsx'
---

<Layout title="La aventura de la foca" description="Una pequeña visual novel interactiva en tres fases.">
  <main class="seal-page">
    <header class="seal-header">
      <a href="/" class="seal-back" aria-label="Volver al inicio">← Inicio</a>
      <p class="seal-kicker">VISUAL NOVEL · 03 FASES</p>
      <span class="seal-mark" aria-hidden="true">◒</span>
    </header>

    <section class="seal-intro">
      <p class="seal-eyebrow">Someone has a special message for you...</p>
      <h2>Happy Birthday!!!</h2>
      <p>Haz clic o pulsa espacio para avanzar por los diálogos.</p>
    </section>

    <section class="seal-stage" aria-label="Juego de la aventura de la foca">
      <SealVisualNovel client:load />
    </section>
  </main>
</Layout>

<style>
  .seal-page {
    min-height: 100dvh;
    padding: 22px clamp(18px, 5vw, 72px) 54px;
    color: #e8fbf8;
    background:
      radial-gradient(circle at 12% 12%, rgba(94, 218, 211, 0.42), transparent 30%),
      radial-gradient(circle at 88% 72%, rgba(62, 145, 193, 0.44), transparent 32%),
      linear-gradient(145deg, #0b3d59 0%, #176783 52%, #235b8a 100%);
    font-family: 'Fredoka Variable', sans-serif;
  }

  .seal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1180px;
    margin: 0 auto;
  }

  .seal-back {
    color: #a9ebe2;
    font-weight: 600;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .seal-back:hover { transform: translateX(-4px); }
  .seal-kicker, .seal-eyebrow { margin: 0; letter-spacing: .18em; font-size: .72rem; font-weight: 700; }
  .seal-kicker { color: #8bd5d1; }
  .seal-mark { color: #ffbd82; font-size: 2rem; transform: rotate(-25deg); }
  .seal-intro { max-width: 1180px; margin: clamp(52px, 9vh, 100px) auto 32px; }
  .seal-eyebrow { margin-bottom: 10px; color: #ffbd82; }
  .seal-intro h2 { margin: 0; max-width: 720px; font-family: 'Sans Serif', cursive; font-size: clamp(2.6rem, 7vw, 5.6rem); font-weight: 400; line-height: 1; letter-spacing: 0; text-align: left; color: #f2fffb; }
  .seal-intro > p:last-child { margin: 18px 0 0; color: #b8e5e4; font-size: 1.05rem; }
  .seal-stage { width: min(1180px, 100%); margin: 0 auto; overflow: hidden; border: 8px solid rgba(158, 239, 230, .48); border-radius: 20px; background: #06283f; box-shadow: 0 26px 60px rgba(1, 17, 35, .48); }
  .seal-game { width: 100%; aspect-ratio: 3 / 2; min-height: 420px; }
  .seal-game canvas { display: block; width: 100% !important; height: 100% !important; }
  .seal-note { max-width: 1180px; margin: 18px auto 0; color: #8fc9cc; font-size: .9rem; }
  .seal-note strong { color: #ffbd82; }

  @media (max-width: 600px) {
    .seal-kicker { display: none; }
    .seal-intro { margin-top: 56px; }
    .seal-stage { border-width: 4px; border-radius: 14px; }
    .seal-game { min-height: 290px; }
  }
</style>